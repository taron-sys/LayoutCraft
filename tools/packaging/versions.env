# Pinned versions of everything the release pipeline installs or downloads (docs/36-packaging.md).
# Plain KEY=VALUE lines: sourced by tools/packaging/lib.sh and appended to $GITHUB_ENV by the release workflow.
# Dependabot does not see these: bump them by hand, in one change, and let the dry run (workflow_dispatch) prove it.

# The Rust toolchain every release is built with (not "stable": a release must not change because a new compiler came out).
RUST_VERSION=1.100.0

# WiX Toolset (dotnet tool, NuGet package "wix"). 5.x is the newest line without the Open Source Maintenance Fee agreement.
WIX_VERSION=5.0.2

# AppImage: appimagetool (runs on x86_64 for both architectures) and the type-2 runtime that gets prepended to the squashfs image.
# Both are downloaded from the projects' GitHub releases and checked against these SHA-256 values before they are used.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_SHA256_X86_64=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGE_RUNTIME_VERSION=20251108
APPIMAGE_RUNTIME_SHA256_X86_64=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
APPIMAGE_RUNTIME_SHA256_AARCH64=00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444
