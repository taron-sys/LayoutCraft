[Desktop Entry]
Version=1.0
Type=Application
Name=LayoutCraft
GenericName=Diagram editor
Comment=Draw diagrams and open Visio drawings
Exec=layoutcraft-app %f
Icon=layoutcraft
Terminal=false
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=diagram;flowchart;network;vsdx;vsd;vdx;
MimeType=application/vnd.ms-visio.drawing;application/vnd.ms-visio.drawing.main+xml;application/vnd.ms-visio.drawing.macroEnabled.main+xml;application/vnd.ms-visio.template.main+xml;application/vnd.ms-visio.template.macroEnabled.main+xml;application/vnd.visio;application/x-visio-xml;
# the window class of the app (eframe uses the application name), so that the taskbar groups the windows under this launcher
StartupWMClass=LayoutCraft
