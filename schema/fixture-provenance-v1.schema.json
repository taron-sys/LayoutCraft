{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://layoutcraft.local/schema/fixture-provenance-v1.schema.json",
  "title": "LayoutCraft fixture provenance inventory v1",
  "type": "object",
  "required": ["manifestVersion", "reviewStatus", "reviewedAt", "policy", "fixtures", "visuals"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "reviewStatus": {
      "enum": ["inventory-complete-legal-review-pending", "cleared", "rejected"]
    },
    "reviewedAt": { "type": "string" },
    "policy": { "type": "string" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fixture", "source", "sourceSha256", "origin", "status",
          "redistributable", "notes"
        ],
        "properties": {
          "fixture": { "type": "string" },
          "source": { "type": "string" },
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "origin": { "enum": ["microsoft-example", "project-corpus", "self-authored", "licensed-third-party"] },
          "status": { "enum": ["internal-validation-only", "review-required", "cleared", "rejected"] },
          "redistributable": { "type": "boolean" },
          "notes": { "type": "string" },
          "licence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "visuals": {
      "type": "object",
      "required": ["manifest", "renderer", "status", "redistributable", "notes"],
      "properties": {
        "manifest": { "type": "string" },
        "renderer": { "type": "string" },
        "status": { "enum": ["validation-only", "cleared", "rejected"] },
        "redistributable": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
