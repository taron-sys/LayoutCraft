{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://layoutcraft.local/schema/golden-manifest-v1.schema.json",
  "title": "LayoutCraft golden fixture manifest v1",
  "type": "object",
  "required": ["manifestVersion", "documentSchemaVersion", "generatedBy", "fixtures"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "documentSchemaVersion": { "const": 1 },
    "generatedBy": { "type": "string" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fixture" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "fixture": {
      "type": "object",
      "required": [
        "id", "kind", "source", "sourceBytes", "sourceSha256",
        "documentSchemaVersion", "model", "modelSha256", "modelFileSha256", "counts", "untouched"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["example", "corpus", "self-authored"] },
        "source": { "type": "string" },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "documentSchemaVersion": { "const": 1 },
        "model": { "type": "string" },
        "modelSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "modelFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "counts": {
          "type": "object",
          "required": ["pages", "shapes", "connectors", "media"],
          "properties": {
            "pages": { "type": "integer", "minimum": 1 },
            "shapes": { "type": "integer", "minimum": 0 },
            "connectors": { "type": "integer", "minimum": 0 },
            "media": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "untouched": {
          "type": "object",
          "required": ["savedName", "entryCount", "entries"],
          "properties": {
            "savedName": { "type": "string" },
            "entryCount": { "type": "integer", "minimum": 1 },
            "entries": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
