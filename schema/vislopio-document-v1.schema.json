{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://layoutcraft.local/schema/layoutcraft-document-v1.schema.json",
  "title": "LayoutCraft document schema v1",
  "description": "Top-level portable JSON document contract. Shape and connector payloads are intentionally permissive; see docs/13-document-schema.md.",
  "type": "object",
  "required": ["schemaVersion", "version", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "pageIndex": { "type": "integer", "minimum": 0 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/page" }
    },
    "theme": { "type": ["object", "null"] },
    "media": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/media" }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "page": {
      "type": "object",
      "required": ["name", "shapes", "connectors"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/definitions/shape" }
        },
        "connectors": {
          "type": "array",
          "items": { "$ref": "#/definitions/connector" }
        },
        "groups": { "type": "array", "items": { "type": "object" } },
        "containers": { "type": "array", "items": { "type": "object" } },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "name"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "name": { "type": "string" },
              "visible": { "type": "boolean" },
              "print": { "type": "boolean" },
              "locked": { "type": "boolean" }
            }
          }
        },
        "guides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["xIn", "yIn"],
            "properties": {
              "visioId": { "type": "string" },
              "xIn": { "type": "number" },
              "yIn": { "type": "number" },
              "angle": { "type": "number" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "shape": {
      "type": "object",
      "required": ["id", "type", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "rot": { "type": "number" },
        "flipX": { "type": "boolean" },
        "flipY": { "type": "boolean" },
        "label": { "type": "string" },
        "fill": { "type": "string" },
        "stroke": { "type": "string" },
        "data": { "type": "array", "items": { "type": "object" } },
        "callout": { "type": ["object", "null"] },
        "attachedTo": { "type": ["string", "null"] },
        "dataColor": { "type": ["object", "null"] },
        "nativeDataGraphic": { "type": ["object", "null"] },
        "layers": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "layerHidden": { "type": "boolean" },
        "image": { "type": ["object", "null"] },
        "parts": { "type": "array", "items": { "type": "object" } },
        "rich": { "type": ["object", "null"] },
        "visio": { "type": "object" }
      },
      "additionalProperties": true
    },
    "connector": {
      "type": "object",
      "required": ["id", "from", "to", "route"],
      "properties": {
        "id": { "type": "string" },
        "from": { "$ref": "#/definitions/endpoint" },
        "to": { "$ref": "#/definitions/endpoint" },
        "route": { "enum": ["straight", "elbow", "curved"] },
        "waypoints": { "type": "array", "items": { "type": "object" } },
        "label": { "type": "string" },
        "stroke": { "type": "string" },
        "strokeWidth": { "type": "number" },
        "strokeStyle": { "type": "string" },
        "arrowStart": { "type": "string" },
        "arrowEnd": { "type": "string" },
        "visio": { "type": "object" }
      },
      "additionalProperties": true
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "shapeId": { "type": ["string", "null"] },
        "side": { "type": ["string", "null"] },
        "point": { "type": ["object", "null"] },
        "local": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "src": { "type": "string" },
        "type": { "type": "string" },
        "ext": { "type": "string" },
        "name": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "adjust": { "type": "boolean" },
        "unsupported": { "type": "boolean" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
